---
const whatsappNumber = "56967335190";
const defaultMessage = encodeURIComponent("Hola Pamela, quisiera consultar por un proyecto.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${defaultMessage}`;
---

<header class="sticky top-0 z-50 bg-brand-bg/90 backdrop-blur-md border-b border-brand-border/60 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="group flex flex-col items-start focus:outline-none">
      <span class="font-script text-3xl sm:text-4xl text-brand-brown tracking-wide group-hover:text-brand-gold transition-colors leading-none">
        Pamela Moya
      </span>
      <span class="font-serif text-[10px] sm:text-xs text-brand-brown-muted tracking-[0.25em] font-medium uppercase mt-0.5">
        Arquitecta
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8 font-medium text-sm text-brand-brown/90">
      <a href="#inicio" class="hover:text-brand-gold transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-gold hover:after:w-full after:transition-all">
        Inicio
      </a>
      <a href="#servicios" class="hover:text-brand-gold transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-gold hover:after:w-full after:transition-all">
        Servicios
      </a>
      <a href="#proposito" class="hover:text-brand-gold transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-gold hover:after:w-full after:transition-all">
        Beneficios
      </a>
      <a href="#contacto" class="hover:text-brand-gold transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-gold hover:after:w-full after:transition-all">
        Contacto
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center space-x-4">
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-brown text-brand-bg hover:bg-brand-brown-dark transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5 font-medium text-sm group"
      >
        <svg class="w-4 h-4 fill-brand-whatsapp group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>+56 9 6733 5190</span>
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button 
      id="mobile-menu-btn" 
      type="button"
      class="md:hidden text-brand-brown p-2 rounded-lg hover:bg-brand-card transition-colors focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-brand-bg/98 border-b border-brand-border px-4 pt-2 pb-6 space-y-4 shadow-lg">
    <a href="#inicio" class="block py-2 text-brand-brown hover:text-brand-gold font-medium border-b border-brand-border/40">Inicio</a>
    <a href="#servicios" class="block py-2 text-brand-brown hover:text-brand-gold font-medium border-b border-brand-border/40">Servicios</a>
    <a href="#proposito" class="block py-2 text-brand-brown hover:text-brand-gold font-medium border-b border-brand-border/40">Beneficios</a>
    <a href="#contacto" class="block py-2 text-brand-brown hover:text-brand-gold font-medium border-b border-brand-border/40">Contacto</a>
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full py-3 rounded-full bg-brand-brown text-brand-bg font-medium text-sm shadow-md mt-4"
    >
      <svg class="w-5 h-5 fill-brand-whatsapp" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>WhatsApp Directo +56 9 6733 5190</span>
    </a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
