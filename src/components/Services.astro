---
const services = [
  {
    id: "ley-del-mono",
    title: "REGULARIZACIONES EN GENERAL",
    subtitle: "Ley del Mono (Ley N.º 20.898)",
    description: "Aplicamos la Ley que corresponde según cada caso, para regularizar construcciones y ampliaciones.",
    iconType: "document",
    whatsappMsg: "Hola Pamela, quisiera consultar por regularizaciones bajo la Ley del Mono (Ley N.º 20.898)."
  },
  {
    id: "seremi",
    title: "REGULARIZACIONES DE SEREMI",
    subtitle: "Trámites Sanitarios e Institucionales",
    description: "Tramitamos y regularizamos proyectos ante SEREMI de Salud y otras instituciones competentes.",
    iconType: "building",
    whatsappMsg: "Hola Pamela, necesito tramitar o regularizar un proyecto ante SEREMI de Salud."
  },
  {
    id: "restaurante",
    title: "PARA RESTAURANTE",
    subtitle: "Regularizaciones de Calificaciones de SEREMI",
    description: "Gestionamos calificaciones sanitarias y regularizaciones para que tu restaurante cumpla con la normativa vigente.",
    iconType: "restaurant",
    whatsappMsg: "Hola Pamela, tengo un restaurante y necesito regularizar mi calificación sanitaria ante SEREMI."
  }
];
---

<section id="servicios" class="py-16 md:py-24 bg-gradient-to-b from-brand-bg via-brand-card/40 to-brand-bg relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-16 reveal-on-scroll">
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-brand-brown tracking-[0.2em] font-semibold uppercase">
        NUESTROS SERVICIOS
      </h2>
      <div class="flex items-center justify-center gap-2 mt-3">
        <div class="w-12 h-px bg-brand-gold/60"></div>
        <div class="w-2 h-2 rounded-full bg-brand-gold"></div>
        <div class="w-12 h-px bg-brand-gold/60"></div>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div 
          class="reveal-on-scroll group relative bg-brand-card/70 hover:bg-brand-card border border-brand-border/80 hover:border-brand-gold/70 rounded-3xl p-8 transition-all duration-300 shadow-warm hover:shadow-warm-hover flex flex-col justify-between"
          style={`transition-delay: ${index * 150}ms;`}
        >
          <div>
            <!-- Service Icon -->
            <div class="w-20 h-20 rounded-full bg-brand-bg border-2 border-brand-border group-hover:border-brand-gold flex items-center justify-center mb-6 shadow-sm group-hover:scale-105 transition-all">
              {service.iconType === "document" && (
                <svg class="w-10 h-10 text-brand-brown stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  <circle cx="16" cy="17" r="4" fill="#FDFBF7" stroke="currentColor" stroke-width="1.5"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.5 17l1 1 2-2" stroke-width="1.8"/>
                </svg>
              )}

              {service.iconType === "building" && (
                <svg class="w-10 h-10 text-brand-brown stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5s0 0 0 0M9 9.75h1.5s0 0 0 0M9 12.75h1.5s0 0 0 0M9 15.75h1.5s0 0 0 0M13.5 6.75h1.5s0 0 0 0M13.5 9.75h1.5s0 0 0 0M13.5 12.75h1.5s0 0 0 0M13.5 15.75h1.5s0 0 0 0M9 19.5h6" />
                </svg>
              )}

              {service.iconType === "restaurant" && (
                <svg class="w-10 h-10 text-brand-brown stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v6a2 2 0 002 2h0a2 2 0 002-2V4M9 4v16M15 4v5c0 1.1.9 2 2 2h0c1.1 0 2-.9 2-2V4M17 11v9" />
                </svg>
              )}
            </div>

            <!-- Title -->
            <h3 class="font-serif text-xl sm:text-2xl text-brand-brown font-semibold tracking-wider mb-2">
              {service.title}
            </h3>

            <!-- Subtitle in script font -->
            <p class="font-script text-2xl text-brand-gold-dark mb-4 leading-tight">
              {service.subtitle}
            </p>

            <!-- Description -->
            <p class="font-sans text-sm sm:text-base text-brand-brown-muted leading-relaxed mb-8">
              {service.description}
            </p>
          </div>

          <!-- Direct CTA Button -->
          <a
            href={`https://wa.me/56967335190?text=${encodeURIComponent(service.whatsappMsg)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-brand-bg border border-brand-border text-brand-brown font-medium text-sm hover:bg-brand-brown hover:text-brand-bg hover:border-brand-brown transition-all duration-300 group-hover:shadow-sm"
          >
            <span>Consultar Servicio</span>
            <svg class="w-4 h-4 text-brand-gold group-hover:text-brand-bg transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
