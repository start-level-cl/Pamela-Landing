---
const whatsappUrl = "https://wa.me/56967335190?text=Hola%20Pamela,%20quisiera%20consultar%20por%20un%20proyecto";
---

<section id="inicio" class="relative pt-6 pb-16 md:py-20 overflow-hidden bg-brand-bg">
  <!-- Subtle Background Decorative Glows -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-accent/20 blur-[100px] pointer-events-none -z-10 rounded-full"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto reveal-on-scroll">
      
      <!-- Leaf & Floral Embellishment SVG Header -->
      <div class="inline-flex flex-col items-center justify-center relative mb-4">
        <!-- Leaf flourish graphic -->
        <div class="absolute -top-10 -right-8 text-brand-gold opacity-85 pointer-events-none">
          <svg class="w-16 h-16" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M50 80 C 40 50, 20 40, 10 30 C 30 30, 40 40, 50 80 Z" fill="#E5D5C6" opacity="0.4"/>
            <path d="M50 80 C 60 50, 80 40, 90 30 C 70 30, 60 40, 50 80 Z" fill="#E5D5C6" opacity="0.4"/>
            <path d="M50 80 L50 20" stroke-linecap="round"/>
            <path d="M50 60 C 65 50, 75 45, 85 45" />
            <path d="M50 45 C 35 35, 25 30, 15 30" />
            <path d="M50 30 C 62 22, 70 18, 78 18" />
          </svg>
        </div>

        <!-- Main Title -->
        <h1 class="font-script text-6xl sm:text-7xl md:text-8xl lg:text-9xl text-brand-brown tracking-tight leading-none drop-shadow-sm select-none">
          Pamela Moya
          <span class="inline-block text-brand-gold text-4xl sm:text-5xl md:text-6xl align-middle font-normal ml-1">♡</span>
        </h1>
        
        <!-- Sub-title ARQUITECTA -->
        <h2 class="font-serif text-lg sm:text-xl md:text-2xl tracking-[0.35em] text-brand-gold-dark font-medium uppercase mt-2">
          ARQUITECTA
        </h2>

        <!-- Divider dot -->
        <div class="w-2 h-2 rounded-full bg-brand-gold/60 my-4"></div>
      </div>

      <!-- Taglines -->
      <div class="space-y-2 mb-10">
        <p class="font-sans text-xs sm:text-sm md:text-base tracking-[0.2em] sm:tracking-[0.25em] text-brand-brown font-semibold uppercase">
          DISEÑAMOS &nbsp;•&nbsp; GESTIONAMOS &nbsp;•&nbsp; REGULARIZAMOS
        </p>
        <p class="font-script text-2xl sm:text-3xl md:text-4xl text-brand-brown-muted">
          para que tu proyecto sea una realidad <span class="text-brand-gold">♡</span>
        </p>
      </div>

      <!-- Architectural Illustration Card -->
      <div class="relative my-8 group rounded-3xl p-4 sm:p-8 bg-gradient-to-b from-brand-card/60 to-brand-card/20 border border-brand-border/70 shadow-warm">
        
        <!-- Architectural Line Art SVG Illustration -->
        <div class="w-full max-w-3xl mx-auto aspect-[16/9] sm:aspect-[21/9] flex items-center justify-center p-2">
          <svg class="w-full h-full text-brand-brown stroke-current" viewBox="0 0 800 360" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <!-- Ground Line -->
            <line x1="40" y1="310" x2="760" y2="310" stroke-width="1.5" stroke="#7A6B60" opacity="0.6"/>
            <line x1="80" y1="315" x2="720" y2="315" stroke-width="0.8" stroke="#7A6B60" opacity="0.4"/>
            
            <!-- Trees Left -->
            <path d="M 90 310 C 70 270 60 210 90 170 C 120 210 110 270 90 310 Z" fill="#E5D5C6" fill-opacity="0.3" stroke-width="1"/>
            <line x1="90" y1="310" x2="90" y2="200" stroke-width="1"/>
            <path d="M 90 270 Q 75 250 65 240 M 90 250 Q 105 235 112 225"/>

            <!-- Main Building Structure - Perspective Lines -->
            <!-- Floor 1 -->
            <polygon points="160,310 520,310 680,270 320,270" fill="#FDFBF7" fill-opacity="0.7" stroke-width="1.5"/>
            <!-- Front Facade Glass panels -->
            <rect x="180" y="220" width="320" height="90" fill="#F6EFE9" fill-opacity="0.5" stroke-width="1.5"/>
            <!-- Vertical Mullions -->
            <line x1="230" y1="220" x2="230" y2="310"/>
            <line x1="280" y1="220" x2="280" y2="310"/>
            <line x1="330" y1="220" x2="330" y2="310"/>
            <line x1="380" y1="220" x2="380" y2="310"/>
            <line x1="430" y1="220" x2="430" y2="310"/>

            <!-- Upper Floor / Cantilever Slab -->
            <polygon points="140,220 540,220 700,180 300,180" fill="#E5D5C6" fill-opacity="0.4" stroke-width="1.8"/>
            <!-- Floor 2 Facade -->
            <polygon points="170,220 170,140 510,140 510,220" fill="#FDFBF7" fill-opacity="0.6" stroke-width="1.5"/>
            <!-- Floor 2 Glass -->
            <rect x="190" y="150" width="300" height="70" fill="#EFE2D6" fill-opacity="0.4"/>
            <!-- Floor 2 Mullions -->
            <line x1="240" y1="150" x2="240" y2="220"/>
            <line x1="290" y1="150" x2="290" y2="220"/>
            <line x1="340" y1="150" x2="340" y2="220"/>
            <line x1="390" y1="150" x2="390" y2="220"/>
            <line x1="440" y1="150" x2="440" y2="220"/>

            <!-- Roof Overhang -->
            <polygon points="130,140 550,140 710,100 290,100" fill="#B89775" fill-opacity="0.25" stroke-width="2"/>
            <line x1="130" y1="140" x2="550" y2="140" stroke-width="2"/>

            <!-- Right Wing Angle -->
            <polygon points="510,140 660,110 660,250 510,290" fill="#EFE2D6" fill-opacity="0.3" stroke-width="1.5"/>
            <line x1="560" y1="130" x2="560" y2="270" stroke-dasharray="3,3"/>
            <line x1="610" y1="120" x2="610" y2="260" stroke-dasharray="3,3"/>

            <!-- Interior Lighting Lines & Reflections -->
            <path d="M 200 240 L 260 290 M 300 230 L 370 295 M 400 230 L 470 295" stroke="#B89775" stroke-width="0.8" opacity="0.6"/>

            <!-- Architectural Scale Figure & Shading -->
            <circle cx="130" cy="285" r="4" stroke-width="1"/>
            <line x1="130" y1="289" x2="130" y2="310" stroke-width="1"/>
          </svg>
        </div>

        <!-- Subtle architectural quote -->
        <div class="mt-4 pt-4 border-t border-brand-border/50 text-center">
          <p class="font-serif italic text-lg sm:text-xl text-brand-brown font-medium tracking-wide">
            “Arquitectura que cumple la norma, proyectos que construyen futuro.”
          </p>
          <div class="text-brand-gold text-lg mt-1">♡</div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-brand-brown text-brand-bg font-semibold text-base shadow-lg hover:bg-brand-brown-dark hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
        >
          <svg class="w-6 h-6 fill-brand-whatsapp group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="font-sans font-bold">+56 9 6733 5190</span>
          <span class="font-script text-xl text-brand-gold font-normal">consulta por tu proyecto ♡</span>
        </a>

        <a 
          href="#servicios" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-2xl border-2 border-brand-border text-brand-brown hover:bg-brand-card hover:border-brand-gold transition-all duration-300 font-medium text-base"
        >
          Ver nuestros servicios
        </a>
      </div>

    </div>
  </div>
</section>
