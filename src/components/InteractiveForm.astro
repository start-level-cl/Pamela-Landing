---
---

<section id="contacto" class="py-16 md:py-24 bg-brand-bg relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-gradient-to-br from-brand-card via-brand-bg to-brand-card border border-brand-border rounded-3xl p-8 sm:p-12 shadow-warm reveal-on-scroll relative overflow-hidden">
      <!-- Background floral accent -->
      <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-brand-accent/30 rounded-full blur-2xl pointer-events-none"></div>

      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl text-brand-brown tracking-wide font-semibold mb-3">
          ¿Listo para regularizar o iniciar tu proyecto?
        </h2>
        <p class="font-script text-3xl text-brand-gold-dark">
          Completa los datos y hablemos directamente por WhatsApp <span class="text-brand-gold">♡</span>
        </p>
      </div>

      <!-- Interactive Form -->
      <form id="whatsapp-quick-form" class="space-y-6 max-w-2xl mx-auto">
        <!-- Service Type Selector -->
        <div>
          <label class="block font-serif text-sm font-semibold uppercase tracking-wider text-brand-brown mb-2">
            Tipo de Trámite o Servicio
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="service" value="Ley del Mono (Ley N.º 20.898)" checked class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-brand-border bg-brand-bg peer-checked:border-brand-brown peer-checked:bg-brand-brown peer-checked:text-brand-bg text-brand-brown font-medium text-sm transition-all text-center shadow-sm">
                Ley del Mono (Ley 20.898)
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="service" value="Regularización SEREMI de Salud" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-brand-border bg-brand-bg peer-checked:border-brand-brown peer-checked:bg-brand-brown peer-checked:text-brand-bg text-brand-brown font-medium text-sm transition-all text-center shadow-sm">
                SEREMI de Salud
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="service" value="Regularización para Restaurante" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-brand-border bg-brand-bg peer-checked:border-brand-brown peer-checked:bg-brand-brown peer-checked:text-brand-bg text-brand-brown font-medium text-sm transition-all text-center shadow-sm">
                Restaurante / Sanitario
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="service" value="Diseño o Proyecto de Arquitectura Nuevo" class="peer sr-only" />
              <div class="p-3.5 rounded-xl border border-brand-border bg-brand-bg peer-checked:border-brand-brown peer-checked:bg-brand-brown peer-checked:text-brand-bg text-brand-brown font-medium text-sm transition-all text-center shadow-sm">
                Proyecto Nuevo / Diseño
              </div>
            </label>
          </div>
        </div>

        <!-- Location / Commune -->
        <div>
          <label for="comuna" class="block font-serif text-sm font-semibold uppercase tracking-wider text-brand-brown mb-2">
            Comuna o Ciudad
          </label>
          <input 
            type="text" 
            id="comuna" 
            name="comuna" 
            placeholder="Ej: Santiago, Las Condes, Viña del Mar..."
            class="w-full px-4 py-3 rounded-xl border border-brand-border bg-brand-bg text-brand-brown placeholder-brand-brown-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold text-sm shadow-sm transition-all"
          />
        </div>

        <!-- Optional Message -->
        <div>
          <label for="mensaje" class="block font-serif text-sm font-semibold uppercase tracking-wider text-brand-brown mb-2">
            Detalles de tu consulta (Opcional)
          </label>
          <textarea 
            id="mensaje" 
            name="mensaje" 
            rows="3" 
            placeholder="Cuenta brevemente qué deseas regularizar o construir..."
            class="w-full px-4 py-3 rounded-xl border border-brand-border bg-brand-bg text-brand-brown placeholder-brand-brown-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold text-sm shadow-sm transition-all"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="w-full py-4 px-6 rounded-2xl bg-brand-brown text-brand-bg font-semibold text-base shadow-lg hover:bg-brand-brown-dark transition-all duration-300 flex items-center justify-center gap-3 group"
        >
          <svg class="w-6 h-6 fill-brand-whatsapp group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Enviar Consulta Directa a WhatsApp (+56 9 6733 5190)</span>
        </button>
      </form>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('whatsapp-quick-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const service = formData.get('service') || 'Regularización de proyecto';
    const comuna = formData.get('comuna') || 'No especificada';
    const mensaje = formData.get('mensaje') || '';

    let text = `Hola Pamela! Quisiera consultar por el servicio de *${service}*.`;
    if (comuna) {
      text += `\nUbicación/Comuna: ${comuna}.`;
    }
    if (mensaje) {
      text += `\nDetalles: ${mensaje}`;
    }

    const whatsappUrl = `https://wa.me/56967335190?text=${encodeURIComponent(text)}`;
    window.open(whatsappUrl, '_blank');
  });
</script>
